direction: right

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 40
    center: true
  }
}

classes: {
  milestone_container: {
    style: {
      stroke: "#DD6B20"
      stroke-width: 2
      border-radius: 8
      fill: "#FFFAF0"
    }
  }
  task_planned: {
    shape: rectangle
    style: {
      stroke: "#C05621"
      stroke-width: 2
      border-radius: 6
      fill: "#FEEBC8"
      font-color: "#7B341E"
      bold: true
    }
  }
}

m2_1: "Milestone 2.1: TCG Part 2 Wire-Level Struct Marshaling" {
  class: milestone_container

  t201: "TASK-201 [Planned]\nTpm2bCodec Command Struct Encoders\nFulfills: [FUNC-006], [TECH-006]" {
    class: task_planned
  }
  t202: "TASK-202 [Planned]\nTpm2bCodec Response Decoders & Bounds\nFulfills: [FUNC-006], [TECH-005], [TECH-006]" {
    class: task_planned
  }

  t201 -> t202: "Critical Path"
}

m2_2: "Milestone 2.2: Salted/Bound HMAC & PolicyPCR Hardware Sessions" {
  class: milestone_container

  t203: "TASK-203 [Planned]\nSalted/Bound StartAuthSession Handshake\nFulfills: [FUNC-007], [TECH-007]" {
    class: task_planned
  }
  t204: "TASK-204 [Planned]\nTPM2_PolicyPCR & Auto Session Framing\nFulfills: [FUNC-007], [TECH-005], [TECH-007]" {
    class: task_planned
  }

  t203 -> t204: "Critical Path"
}

m2_1.t202 -> m2_2.t203: "Critical Path"
